<Window x:Class="HumbleBundleAssets.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HumbleBundleAssets"
        xmlns:vm="clr-namespace:HumbleBundleAssets.ViewModels"
        mc:Ignorable="d"
        Title="Zone Of Fun - Humble Bundle Assets Catalogue"
        Height="840" Width="1340"
        MinHeight="680" MinWidth="1080"
        Background="{StaticResource BgDarkBrush}"
        WindowStartupLocation="CenterScreen"
        TextOptions.TextFormattingMode="Display"
        SnapsToDevicePixels="True">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Header Bar -->
            <RowDefinition Height="*" />    <!-- Main Content (Sidebar + Active Panel) -->
            <RowDefinition Height="Auto" /> <!-- Permanent Footer Bar -->
        </Grid.RowDefinitions>

        <!-- ========================================== -->
        <!-- HEADER BAR                                 -->
        <!-- ========================================== -->
        <Border Grid.Row="0"
                Background="{StaticResource BgPanelBrush}"
                BorderBrush="{StaticResource BorderDarkBrush}"
                BorderThickness="0,0,0,1"
                Padding="18,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- App Branding -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#1E293B" CornerRadius="8" Padding="8,4" Margin="0,0,12,0" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1">
                        <TextBlock Text="ZONE OF FUN" FontWeight="Bold" FontSize="11" Foreground="{StaticResource AccentBrush}" />
                    </Border>
                    <TextBlock Text="Humble Bundle Asset Catalogue"
                               FontWeight="Bold"
                               FontSize="17"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>

                <!-- Active Database Indicator & Database Controls -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Active Database:"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="12"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0" />

                    <!-- Active DB Badge with Tooltip -->
                    <Border Background="{StaticResource BgCardBrush}"
                            BorderBrush="{StaticResource BorderDarkBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="10,5"
                            Margin="0,0,10,0"
                            ToolTip="{Binding ActiveDatabasePath}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🗄️" Margin="0,0,6,0" FontSize="12" />
                            <TextBlock Text="{Binding ActiveDatabaseName}"
                                       Foreground="{StaticResource AccentBrush}"
                                       FontWeight="SemiBold"
                                       FontSize="12" />
                        </StackPanel>
                    </Border>

                    <!-- Open Existing DB -->
                    <Button Content="📂 Open DB..."
                            Command="{Binding OpenDatabaseCommand}"
                            Style="{StaticResource ModernButtonStyle}"
                            Margin="0,0,6,0"
                            Padding="10,5"
                            FontSize="12"
                            ToolTip="Open an existing SQLite catalogue database" />

                    <!-- Create New DB -->
                    <Button Content="✨ New DB..."
                            Command="{Binding NewDatabaseCommand}"
                            Style="{StaticResource ModernButtonStyle}"
                            Padding="10,5"
                            FontSize="12"
                            ToolTip="Create a new SQLite catalogue database" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ========================================== -->
        <!-- MAIN CONTENT (TOOLBAR + ACTIVE PANEL)      -->
        <!-- ========================================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" /> <!-- Left Hand Navigation Toolbar -->
                <ColumnDefinition Width="*" />   <!-- Active Panel Body -->
            </Grid.ColumnDefinitions>

            <!-- LEFT HAND NAVIGATION TOOLBAR -->
            <Border Grid.Column="0"
                    Background="{StaticResource BgPanelBrush}"
                    BorderBrush="{StaticResource BorderDarkBrush}"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="NAVIGATION"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextMutedBrush}"
                               Margin="16,16,16,10" />

                    <!-- Toolbar Buttons -->
                    <StackPanel Grid.Row="1" Margin="8,0">
                        <!-- Setup Button -->
                        <RadioButton GroupName="NavTabs"
                                     IsChecked="{Binding IsSetupTabSelected, Mode=TwoWay}"
                                     Command="{Binding NavigateToSetupCommand}"
                                     Margin="0,0,0,6">
                            <RadioButton.Template>
                                <ControlTemplate TargetType="RadioButton">
                                    <Border x:Name="navBorder"
                                            Background="Transparent"
                                            CornerRadius="8"
                                            Padding="14,12"
                                            Cursor="Hand">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="⚙️" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="Setup"
                                                           FontWeight="SemiBold"
                                                           FontSize="14"
                                                           Foreground="{StaticResource TextPrimaryBrush}" />
                                                <TextBlock Text="Folders &amp; Indexing"
                                                           FontSize="11"
                                                           Foreground="{StaticResource TextSecondaryBrush}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="navBorder" Property="Background" Value="{StaticResource BgCardBrush}" />
                                            <Setter TargetName="navBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                            <Setter TargetName="navBorder" Property="BorderThickness" Value="1" />
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="navBorder" Property="Background" Value="{StaticResource BgCardHoverBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </RadioButton.Template>
                        </RadioButton>

                        <!-- Catalogue Search Button -->
                        <RadioButton GroupName="NavTabs"
                                     IsChecked="{Binding IsSearchTabSelected, Mode=TwoWay}"
                                     Command="{Binding NavigateToSearchCommand}"
                                     Margin="0,0,0,6">
                            <RadioButton.Template>
                                <ControlTemplate TargetType="RadioButton">
                                    <Border x:Name="navBorder"
                                            Background="Transparent"
                                            CornerRadius="8"
                                            Padding="14,12"
                                            Cursor="Hand">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="🔍" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="Search"
                                                           FontWeight="SemiBold"
                                                           FontSize="14"
                                                           Foreground="{StaticResource TextPrimaryBrush}" />
                                                <TextBlock Text="Filter, Preview &amp; Extract"
                                                           FontSize="11"
                                                           Foreground="{StaticResource TextSecondaryBrush}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="navBorder" Property="Background" Value="{StaticResource BgCardBrush}" />
                                            <Setter TargetName="navBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                            <Setter TargetName="navBorder" Property="BorderThickness" Value="1" />
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="navBorder" Property="Background" Value="{StaticResource BgCardHoverBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </RadioButton.Template>
                        </RadioButton>
                    </StackPanel>

                    <!-- Sidebar Footer Info -->
                    <Border Grid.Row="2"
                            Background="{StaticResource BgCardBrush}"
                            BorderBrush="{StaticResource BorderDarkBrush}"
                            BorderThickness="0,1,0,0"
                            Padding="12,14">
                        <StackPanel>
                            <TextBlock Text="CATALOGUE STATS" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4" />
                            <TextBlock Text="{Binding TotalCatalogedAssets, StringFormat='{}{0:N0} assets indexed'}"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentBrush}"
                                       FontSize="12" />
                            <TextBlock Text="Unity Ready Formats" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- MAIN BODY PANELS -->
            <Grid Grid.Column="1">
                <!-- ============================================== -->
                <!-- PANEL 1: SETUP PANEL                           -->
                <!-- ============================================== -->
                <Grid Visibility="{Binding IsSetupTabSelected, Converter={StaticResource BoolToVis}}"
                      Margin="24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Setup Header -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,16">
                        <TextBlock Text="Asset Catalogue Setup"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="Configure the list of folders containing your Humble Bundle assets or zip bundles. Folders are saved persistently in the SQLite database."
                                   FontSize="13"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,4,0,0" />
                    </StackPanel>

                    <!-- Folders List Card -->
                    <Border Grid.Row="1"
                            Background="{StaticResource BgCardBrush}"
                            BorderBrush="{StaticResource BorderDarkBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,12">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="📁" FontSize="16" Margin="0,0,8,0" />
                                    <TextBlock Text="Folders to Index"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Text="{Binding IndexedFolders.Count, StringFormat=' ({0} configured)'}"
                                               FontSize="13"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               VerticalAlignment="Center" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="➕ Add Folder..."
                                            Command="{Binding AddFolderCommand}"
                                            Style="{StaticResource AccentButtonStyle}"
                                            Margin="0,0,8,0"
                                            ToolTip="Select a directory to add to the catalogue list" />
                                    <Button Content="🗑️ Remove Selected"
                                            Command="{Binding RemoveFolderCommand}"
                                            Style="{StaticResource DangerButtonStyle}"
                                            ToolTip="Remove selected folder and its entries from the catalogue" />
                                </StackPanel>
                            </Grid>

                            <!-- Folder Items ListBox -->
                            <ListBox Grid.Row="1"
                                     ItemsSource="{Binding IndexedFolders}"
                                     SelectedItem="{Binding SelectedFolder}"
                                     Background="{StaticResource BgDarkBrush}"
                                     BorderBrush="{StaticResource BorderDarkBrush}"
                                     BorderThickness="1"
                                     ScrollViewer.HorizontalScrollBarVisibility="Auto">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="10,8" Margin="2,2" CornerRadius="4">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="📂" FontSize="15" Margin="0,0,10,0" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding FolderPath}"
                                                           FontSize="13"
                                                           FontWeight="Medium"
                                                           Foreground="{StaticResource TextPrimaryBrush}"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding DateAdded, StringFormat='Added: {0:g}'}"
                                                           FontSize="11"
                                                           Foreground="{StaticResource TextMutedBrush}"
                                                           VerticalAlignment="Center"
                                                           Margin="16,0,0,0" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <!-- Helper Note -->
                            <TextBlock Grid.Row="2"
                                       Text="💡 Fast Zip Central Directory Scanning: Zipped bundles are indexed directly without unzipping to disk. Re-cataloguing is completely idempotent and safe to run anytime."
                                       FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="0,12,0,0" />
                        </Grid>
                    </Border>

                    <!-- Start Cataloguing Card -->
                    <Border Grid.Row="2"
                            Background="{StaticResource BgPanelBrush}"
                            BorderBrush="{StaticResource BorderDarkBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="20"
                            Margin="0,16,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Run Catalogue Process"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="Indexes all valid Unity assets (.wav, .mp3, .ogg, .png, .jpg, .gif, .fbx, .obj, .txt, .json, .unitypackage, etc.) found in the selected folders and inside ZIP archives."
                                           FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Margin="0,4,0,0" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="▶️ Start Cataloguing"
                                        Command="{Binding StartCatalogCommand}"
                                        Style="{StaticResource AccentButtonStyle}"
                                        FontSize="14"
                                        Padding="20,10"
                                        ToolTip="Start asynchronous background cataloguing process" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ============================================== -->
                <!-- PANEL 2: CATALOGUE SEARCH PANEL                -->
                <!-- ============================================== -->
                <Grid Visibility="{Binding IsSearchTabSelected, Converter={StaticResource BoolToVis}}"
                      Margin="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="6*" MinWidth="480" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="4*" MinWidth="340" />
                    </Grid.ColumnDefinitions>

                    <!-- LEFT / MIDDLE SECTION: FILTERS & SEARCH RESULTS LIST -->
                    <Grid Grid.Column="0" Margin="0,0,10,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" /> <!-- Filters Card -->
                            <RowDefinition Height="Auto" /> <!-- Action & Multi-select Bar -->
                            <RowDefinition Height="*" />    <!-- Results List -->
                        </Grid.RowDefinitions>

                        <!-- Filter Controls Card -->
                        <Border Grid.Row="0"
                                Background="{StaticResource BgCardBrush}"
                                BorderBrush="{StaticResource BorderDarkBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="14"
                                Margin="0,0,0,10">
                            <StackPanel>
                                <!-- Row 1: Partial Word Search & Category -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="1*" />
                                        <ColumnDefinition Width="1*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Keyword Search -->
                                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                        <TextBlock Text="Partial Name / Path Search" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                        <TextBox Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>

                                    <!-- Category -->
                                    <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                        <TextBlock Text="Category" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                        <ComboBox ItemsSource="{Binding Categories}"
                                                  SelectedItem="{Binding SelectedCategory}" />
                                    </StackPanel>

                                    <!-- File Type -->
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="File Extension" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                        <ComboBox ItemsSource="{Binding FileTypes}"
                                                  SelectedItem="{Binding SelectedFileType}" />
                                    </StackPanel>
                                </Grid>

                                <!-- Row 2: Size Filters & Search Buttons -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="60" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="60" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Size From -->
                                    <TextBlock Grid.Column="0" Text="Size From:" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBox Grid.Column="1" Text="{Binding MinSizeText, UpdateSourceTrigger=PropertyChanged}" Margin="6,0,0,0" />
                                    <ComboBox Grid.Column="2" ItemsSource="{Binding SizeUnits}" SelectedItem="{Binding MinSizeUnit}" Margin="4,0,0,0" />

                                    <!-- Size To -->
                                    <TextBlock Grid.Column="3" Text="Size To:" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="12,0,0,0" />
                                    <TextBox Grid.Column="4" Text="{Binding MaxSizeText, UpdateSourceTrigger=PropertyChanged}" Margin="6,0,0,0" />
                                    <ComboBox Grid.Column="5" ItemsSource="{Binding SizeUnits}" SelectedItem="{Binding MaxSizeUnit}" Margin="4,0,0,0" />

                                    <!-- Action Buttons -->
                                    <StackPanel Grid.Column="7" Orientation="Horizontal">
                                        <Button Content="🔄 Reset"
                                                Command="{Binding ResetFiltersCommand}"
                                                Style="{StaticResource ModernButtonStyle}"
                                                Margin="0,0,8,0"
                                                Padding="12,6" />
                                        <Button Content="🔍 Search"
                                                Command="{Binding SearchCommand}"
                                                Style="{StaticResource AccentButtonStyle}"
                                                Padding="16,6" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Action & Multi-select Bar -->
                        <Border Grid.Row="1"
                                Background="{StaticResource BgPanelBrush}"
                                BorderBrush="{StaticResource BorderDarkBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12,8"
                                Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Selection Controls -->
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="☑️ Select All"
                                            Command="{Binding SelectAllCommand}"
                                            Style="{StaticResource ModernButtonStyle}"
                                            Padding="8,4"
                                            FontSize="12"
                                            Margin="0,0,6,0" />
                                    <Button Content="⬜ Clear Selection"
                                            Command="{Binding ClearSelectionCommand}"
                                            Style="{StaticResource ModernButtonStyle}"
                                            Padding="8,4"
                                            FontSize="12"
                                            Margin="0,0,12,0" />

                                    <Border Background="#1E293B" CornerRadius="4" Padding="8,4">
                                        <TextBlock Text="{Binding SelectedAssetsCount, StringFormat='Selected: {0}'}"
                                                   FontWeight="SemiBold"
                                                   FontSize="12"
                                                   Foreground="{StaticResource AccentBrush}" />
                                    </Border>
                                </StackPanel>

                                <!-- Extract Button -->
                                <Button Grid.Column="2"
                                        Content="📦 Extract Selected..."
                                        Command="{Binding ExtractSelectedCommand}"
                                        Style="{StaticResource SuccessButtonStyle}"
                                        Padding="14,6"
                                        FontSize="12"
                                        ToolTip="Extract all checked items to a folder of your choice" />
                            </Grid>
                        </Border>

                        <!-- Results List View with Dynamic Row Background for Preview Support -->
                        <Border Grid.Row="2"
                                Background="{StaticResource BgDarkBrush}"
                                BorderBrush="{StaticResource BorderDarkBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                            <ListView ItemsSource="{Binding SearchResults}"
                                      SelectedItem="{Binding SelectedAsset}"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <!-- Row Background Changes if Preview is Not Available -->
                                        <Setter Property="Background" Value="{Binding IsPreviewSupported, Converter={StaticResource PreviewBgConverter}}" />
                                        <Setter Property="BorderBrush" Value="{StaticResource BorderDarkBrush}" />
                                        <Setter Property="BorderThickness" Value="0,0,0,1" />
                                        <Setter Property="Padding" Value="6,4" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Style.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="#1E3A5F" />
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#2A3240" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="2,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" /> <!-- Checkbox -->
                                                <ColumnDefinition Width="65" />  <!-- Type Badge -->
                                                <ColumnDefinition Width="*" />   <!-- Name & Location -->
                                                <ColumnDefinition Width="80" />  <!-- File Size -->
                                                <ColumnDefinition Width="105" /> <!-- Preview Status Badge -->
                                            </Grid.ColumnDefinitions>

                                            <!-- Checkbox for Multi-select -->
                                            <CheckBox Grid.Column="0"
                                                      IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,10,0" />

                                            <!-- File Type Badge -->
                                            <Border Grid.Column="1"
                                                    Background="{StaticResource BgCardBrush}"
                                                    BorderBrush="{StaticResource BorderLightBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="4"
                                                    Padding="4,2"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding FileType}"
                                                           FontSize="11"
                                                           FontWeight="Bold"
                                                           Foreground="{StaticResource AccentBrush}"
                                                           TextAlignment="Center" />
                                            </Border>

                                            <!-- Name & Display Location -->
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="4,0,8,0">
                                                <TextBlock Text="{Binding FileName}"
                                                           FontWeight="SemiBold"
                                                           FontSize="13"
                                                           Foreground="{StaticResource TextPrimaryBrush}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding DisplayLocation}"
                                                           FontSize="11"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding DisplayLocation}" />
                                            </StackPanel>

                                            <!-- File Size -->
                                            <TextBlock Grid.Column="3"
                                                       Text="{Binding FormattedFileSize}"
                                                       FontSize="12"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       VerticalAlignment="Center"
                                                       HorizontalAlignment="Right"
                                                       Margin="0,0,8,0" />

                                            <!-- Preview Status Badge -->
                                            <Border Grid.Column="4"
                                                    Background="{Binding IsPreviewSupported, Converter={StaticResource PreviewBadgeBgConverter}}"
                                                    CornerRadius="4"
                                                    Padding="6,3"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding IsPreviewSupported, Converter={StaticResource PreviewBadgeTextConverter}}"
                                                           Foreground="{Binding IsPreviewSupported, Converter={StaticResource PreviewBadgeFgConverter}}"
                                                           FontSize="10"
                                                           FontWeight="SemiBold" />
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Border>
                    </Grid>

                    <!-- SPLITTER -->
                    <GridSplitter Grid.Column="1"
                                  Width="8"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Stretch"
                                  Background="Transparent"
                                  Cursor="SizeWE" />

                    <!-- RIGHT SECTION: ITEM DETAILS & PREVIEW -->
                    <Border Grid.Column="2"
                            Background="{StaticResource BgCardBrush}"
                            BorderBrush="{StaticResource BorderDarkBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" /> <!-- Item Details -->
                                <RowDefinition Height="Auto" /> <!-- Action Buttons -->
                                <RowDefinition Height="*" />    <!-- Preview Section -->
                            </Grid.RowDefinitions>

                            <!-- DETAILS CARD -->
                            <StackPanel Grid.Row="0">
                                <TextBlock Text="Asset Details"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           Margin="0,0,0,12" />

                                <!-- When No Item Selected -->
                                <TextBlock Text="Select an asset from the search list to inspect details and preview content."
                                           Foreground="{StaticResource TextMutedBrush}"
                                           FontSize="13"
                                           Visibility="{Binding HasSelectedAsset, Converter={StaticResource InverseBoolToVis}}"
                                           Margin="0,0,0,12" />

                                <!-- Selected Item Info Grid -->
                                <Grid Visibility="{Binding HasSelectedAsset, Converter={StaticResource BoolToVis}}" Margin="0,0,0,12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="85" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Name -->
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Name:" Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,2" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedAsset.FileName}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" Margin="0,2" TextWrapping="Wrap" />

                                    <!-- Type & Size -->
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Type &amp; Size:" Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,2" />
                                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,2">
                                        <TextBlock Text="{Binding SelectedAsset.FileType}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" FontSize="12" />
                                        <TextBlock Text=" • " Foreground="{StaticResource TextMutedBrush}" />
                                        <TextBlock Text="{Binding SelectedAsset.FormattedFileSize}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" />
                                        <TextBlock Text=" • " Foreground="{StaticResource TextMutedBrush}" />
                                        <TextBlock Text="{Binding SelectedAsset.Category}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                                    </StackPanel>

                                    <!-- Location -->
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Container:" Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,2" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedAsset.FilePath}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,2" TextWrapping="Wrap" />

                                    <!-- Inner Path (if Zip) -->
                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Zip Entry:" Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,2"
                                               Visibility="{Binding SelectedAsset.IsZipArchive, Converter={StaticResource BoolToVis}}" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedAsset.InnerPath}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,2" TextWrapping="Wrap"
                                               Visibility="{Binding SelectedAsset.IsZipArchive, Converter={StaticResource BoolToVis}}" />

                                    <!-- Date Modified -->
                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Modified:" Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,2" />
                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectedAsset.DateModified, StringFormat='{}{0:g}'}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,2" />
                                </Grid>
                            </StackPanel>

                            <!-- ACTION BUTTONS -->
                            <StackPanel Grid.Row="1"
                                        Orientation="Horizontal"
                                        Margin="0,0,0,16"
                                        Visibility="{Binding HasSelectedAsset, Converter={StaticResource BoolToVis}}">
                                <Button Content="💾 Extract Item..."
                                        Command="{Binding ExtractCurrentItemCommand}"
                                        Style="{StaticResource SuccessButtonStyle}"
                                        Margin="0,0,8,0"
                                        FontSize="12"
                                        Padding="10,5" />
                                <Button Content="📂 Open in Explorer"
                                        Command="{Binding OpenExplorerCommand}"
                                        Style="{StaticResource ModernButtonStyle}"
                                        FontSize="12"
                                        Padding="10,5" />
                            </StackPanel>

                            <!-- PREVIEW CONTAINER -->
                            <Border Grid.Row="2"
                                    Background="{StaticResource BgDarkBrush}"
                                    BorderBrush="{StaticResource BorderDarkBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="10">
                                <Grid>
                                    <!-- Loading Indicator -->
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                                Visibility="{Binding IsPreviewLoading, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="⏳" FontSize="28" HorizontalAlignment="Center" Margin="0,0,0,8" />
                                        <TextBlock Text="Extracting &amp; preparing preview..."
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   FontSize="12" />
                                    </StackPanel>

                                    <!-- IMAGE PREVIEW -->
                                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Auto"
                                                  Visibility="{Binding IsImagePreview, Converter={StaticResource BoolToVis}}">
                                        <Image Source="{Binding PreviewImageSource}"
                                               Stretch="Uniform"
                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                    </ScrollViewer>

                                    <!-- AUDIO PREVIEW -->
                                    <StackPanel VerticalAlignment="Center"
                                                HorizontalAlignment="Center"
                                                Visibility="{Binding IsAudioPreview, Converter={StaticResource BoolToVis}}"
                                                Width="280">
                                        <TextBlock Text="🎵" FontSize="42" HorizontalAlignment="Center" Margin="0,0,0,8" />
                                        <TextBlock Text="{Binding SelectedAsset.FileName}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   FontSize="13"
                                                   TextAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,0,0,6" />

                                        <!-- Time Display -->
                                        <TextBlock Text="{Binding AudioTimeDisplay}"
                                                   Foreground="{StaticResource AccentBrush}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,0,0,10" />

                                        <!-- Scrubbing Slider -->
                                        <Slider Minimum="0"
                                                Maximum="{Binding AudioDurationSeconds}"
                                                Value="{Binding AudioPositionSeconds, Mode=TwoWay}"
                                                ValueChanged="AudioSlider_ValueChanged"
                                                Margin="0,0,0,16" />

                                        <!-- Playback Controls -->
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Button Content="▶ Play"
                                                    Command="{Binding PlayAudioCommand}"
                                                    Style="{StaticResource AccentButtonStyle}"
                                                    Margin="0,0,8,0"
                                                    Padding="14,6" />
                                            <Button Content="⏸ Pause"
                                                    Command="{Binding PauseAudioCommand}"
                                                    Style="{StaticResource ModernButtonStyle}"
                                                    Margin="0,0,8,0"
                                                    Padding="14,6" />
                                            <Button Content="⏹ Stop"
                                                    Command="{Binding StopAudioCommand}"
                                                    Style="{StaticResource ModernButtonStyle}"
                                                    Padding="14,6" />
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- TEXT / CODE PREVIEW -->
                                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Auto"
                                                  Visibility="{Binding IsTextPreview, Converter={StaticResource BoolToVis}}">
                                        <TextBox Text="{Binding TextPreviewContent}"
                                                 IsReadOnly="True"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 Foreground="{StaticResource TextPrimaryBrush}"
                                                 FontFamily="{StaticResource CodeFont}"
                                                 FontSize="12"
                                                 TextWrapping="Wrap" />
                                    </ScrollViewer>

                                    <!-- NO PREVIEW / PLACEHOLDER -->
                                    <StackPanel VerticalAlignment="Center"
                                                HorizontalAlignment="Center"
                                                Visibility="{Binding IsNoPreview, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="📄" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,8" />
                                        <TextBlock Text="{Binding NoPreviewMessage}"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   FontSize="12"
                                                   TextAlignment="Center"
                                                   TextWrapping="Wrap"
                                                   MaxWidth="240" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <!-- ========================================== -->
        <!-- PERMANENT FOOTER BAR                       -->
        <!-- ========================================== -->
        <Border Grid.Row="2"
                Background="{StaticResource BgPanelBrush}"
                BorderBrush="{StaticResource BorderDarkBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Status Message -->
                <TextBlock Grid.Column="0"
                           Text="{Binding StatusMessage}"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="12"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />

                <!-- Progress Bar (Always visible in footer during background tasks) -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Visibility="{Binding IsProgressIndeterminate, Converter={StaticResource BoolToVis}}"
                            Margin="16,0">
                    <ProgressBar IsIndeterminate="True"
                                 Width="180"
                                 Height="10"
                                 Margin="0,0,10,0"
                                 BorderThickness="0"
                                 Background="{StaticResource BgDarkBrush}"
                                 Foreground="{StaticResource AccentBrush}" />

                    <!-- Cancel Button for Running Catalog / Extraction -->
                    <Button Content="❌ Cancel"
                            Command="{Binding CancelCatalogCommand}"
                            Style="{StaticResource DangerButtonStyle}"
                            Padding="8,3"
                            FontSize="11" />
                </StackPanel>

                <!-- Company Branding / Quick Indicator -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Zone Of Fun" Foreground="{StaticResource TextMutedBrush}" FontSize="11" FontWeight="SemiBold" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
